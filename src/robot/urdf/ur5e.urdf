<?xml version="1.0"?>
<robot name="ur5e">
<!--
  Universal Robots UR5e kinematic and inertial parameters.

  Source: UniversalRobots/Universal_Robots_ROS2_Description
  (https://github.com/UniversalRobots/Universal_Robots_ROS2_Description),
  branch `rolling`, retrieved 2026-08-20:
    - config/ur5e/default_kinematics.yaml   (joint origins)
    - config/ur5e/physical_parameters.yaml  (link mass/COG/inertia tensors)
    - config/ur5e/joint_limits.yaml         (position/velocity/effort limits)
    - urdf/ur_macro.xacro, urdf/inc/ur_common.xacro (joint chain, axis, and
      cylinder_inertial semantics that the numeric values above are plugged
      into)
  Licensed under BSD-3-Clause; (c) Universal Robots A/S and contributors.

  This file is a manually flattened, mesh-free URDF (kinematics + inertials
  only) built from the upstream xacro macros and per-robot config values. It
  preserves the full functional kinematic/dynamic chain, including the
  `base_link_inertia` frame (pi rotation about Z between `base_link` and the
  serial chain) and the `flange`/`tool0` tool-frame chain, since
  `reforge_core.util.robot_dynamics` looks up the TCP frame by the exact name
  `tool0` when present. It omits upstream visual/collision geometry and the
  auxiliary ROS-Industrial `base`/`ft_frame` reference frames, which are not
  used by Reforge's calibration/dynamics pipeline. Two near-zero (~1e-11 m)
  floating-point residuals in the upstream wrist_2/wrist_3 kinematics
  (calibration noise, not real offsets) were rounded to 0.0.
-->
<!-- ********** KINEMATIC PROPERTIES (JOINTS) ********** -->
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
  </joint>
  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
    <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.0 0.0"/>
  </joint>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia"/>
    <child link="shoulder_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.1625"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="150.0" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin rpy="1.570796327 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="150.0" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="-0.425 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <!-- Position range is artificially limited to +-pi (half the physical
         range) upstream: the shoulder_lift joint physically blocks the full
         +-2pi sweep, and allowing it causes IK/planning search-space splits.
         See https://github.com/ros-industrial/universal_robot/issues/265 -->
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="150.0" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="-0.3922 0.0 0.1333"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="28.0" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin rpy="1.570796327 0.0 0.0" xyz="0.0 -0.0997 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="28.0" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin rpy="1.570796326589793 3.141592653589793 3.141592653589793" xyz="0.0 0.0996 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="28.0" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin rpy="0.0 -1.5707963267948966 -1.5707963267948966" xyz="0.0 0.0 0.0"/>
  </joint>
  <joint name="flange-tool0" type="fixed">
    <parent link="flange"/>
    <child link="tool0"/>
    <origin rpy="1.5707963267948966 0.0 1.5707963267948966" xyz="0.0 0.0 0.0"/>
  </joint>
<!-- ********** INERTIAL PROPERTIES (LINKS) ********** -->
  <link name="world"/>
  <link name="base_link">
    <inertial>
      <mass value="4.0"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.00443333156" ixy="0.0" ixz="0.0" iyy="0.00443333156" iyz="0.0" izz="0.0072"/>
    </inertial>
  </link>
  <link name="base_link_inertia"/>
  <link name="shoulder_link">
    <inertial>
      <mass value="3.761"/>
      <origin rpy="1.570796326794897 0 0" xyz="0.0 -0.00193 -0.02561"/>
      <inertia ixx="0.00700210" ixy="0.00000073" ixz="-0.00001053" iyy="0.00648091" iyz="0.00049994" izz="0.00657286"/>
    </inertial>
  </link>
  <link name="upper_arm_link">
    <inertial>
      <mass value="8.058"/>
      <origin rpy="0 0 0" xyz="-0.2125 0.0 0.11336"/>
      <inertia ixx="0.01505885" ixy="-0.00005400" ixz="0.00000563" iyy="0.33388086" iyz="-0.00000181" izz="0.33247207"/>
    </inertial>
  </link>
  <link name="forearm_link">
    <inertial>
      <mass value="2.846"/>
      <origin rpy="0 0 0" xyz="-0.2422 0.0 0.0265"/>
      <inertia ixx="0.00399632" ixy="-0.00001365" ixz="0.00137272" iyy="0.07879254" iyz="-0.00000660" izz="0.07848510"/>
    </inertial>
  </link>
  <link name="wrist_1_link">
    <inertial>
      <mass value="1.37"/>
      <origin rpy="1.570796326794897 0 0" xyz="0.0 -0.01634 -0.0018"/>
      <inertia ixx="0.00165491" ixy="-0.00000282" ixz="-0.00000438" iyy="0.00135962" iyz="0.00010157" izz="0.00126279"/>
    </inertial>
  </link>
  <link name="wrist_2_link">
    <inertial>
      <mass value="1.3"/>
      <origin rpy="-1.570796326794897 0 0" xyz="0.0 0.01634 -0.0018"/>
      <inertia ixx="0.00135617" ixy="-0.00000274" ixz="0.00000444" iyy="0.00127827" iyz="-0.00005048" izz="0.00096614"/>
    </inertial>
  </link>
  <link name="wrist_3_link">
    <inertial>
      <mass value="0.365"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 -0.001159"/>
      <inertia ixx="0.00018694" ixy="0.00000006" ixz="-0.00000017" iyy="0.00018908" iyz="-0.00000092" izz="0.00025756"/>
    </inertial>
  </link>
  <link name="flange"/>
  <link name="tool0"/>
</robot>
